{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viggomeesters.github.io/guru-benchmark/skills/guru-benchmark/response.schema.json",
  "title": "Guru Benchmark Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["guru_verdict", "guru_score", "ultimate_design", "clarification", "guru_contributions", "next_moves", "pins", "evidence_refs", "uncertainty"],
  "properties": {
    "guru_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "summary"],
      "properties": {
        "decision": {"enum": ["go", "conditional_go", "hold", "reject"]},
        "summary": {"type": "string", "minLength": 8}
      }
    },
    "guru_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "north_star", "confidence", "dispersion", "hard_gate_status"],
      "properties": {
        "current": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "north_star": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "confidence": {"enum": ["low", "medium", "high"]},
        "dispersion": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "hard_gate_status": {"enum": ["passed", "conditional", "failed", "not_scored"]}
      }
    },
    "ultimate_design": {"type": "string", "minLength": 8},
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_disagreement", "assumptions", "abstentions"],
      "properties": {
        "material_disagreement": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "abstentions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "guru_contributions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"properties": {"member_ref": {"const": "andrew-karpathy"}, "public_label": {"const": "model-guru"}}, "required": ["member_ref", "public_label"]},
        {"properties": {"member_ref": {"const": "matt-pocock"}, "public_label": {"const": "type-guru"}}, "required": ["member_ref", "public_label"]},
        {"properties": {"member_ref": {"const": "peter-steinberger"}, "public_label": {"const": "skill-guru"}}, "required": ["member_ref", "public_label"]},
        {"properties": {"member_ref": {"const": "rich-hickey"}, "public_label": {"const": "simplicity-guru"}}, "required": ["member_ref", "public_label"]},
        {"properties": {"member_ref": {"const": "dhh"}, "public_label": {"const": "delivery-guru"}}, "required": ["member_ref", "public_label"]},
        {"properties": {"member_ref": {"const": "simon-willison"}, "public_label": {"const": "security-guru"}}, "required": ["member_ref", "public_label"]},
        {"properties": {"member_ref": {"const": "mitchell-hashimoto"}, "public_label": {"const": "automation-guru"}}, "required": ["member_ref", "public_label"]}
      ],
      "allOf": [
        {"contains": {"properties": {"public_label": {"const": "model-guru"}}, "required": ["public_label"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"public_label": {"const": "type-guru"}}, "required": ["public_label"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"public_label": {"const": "skill-guru"}}, "required": ["public_label"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"public_label": {"const": "simplicity-guru"}}, "required": ["public_label"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"public_label": {"const": "delivery-guru"}}, "required": ["public_label"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"public_label": {"const": "security-guru"}}, "required": ["public_label"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"public_label": {"const": "automation-guru"}}, "required": ["public_label"]}, "minContains": 1, "maxContains": 1}
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member_ref", "public_label", "role", "contribution", "confidence", "evidence_refs"],
        "properties": {
          "member_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "public_label": {"enum": ["model-guru", "type-guru", "skill-guru", "simplicity-guru", "delivery-guru", "security-guru", "automation-guru"]},
          "role": {"enum": ["primary", "supporting", "counterweight", "abstain"]},
          "contribution": {"type": "string", "minLength": 2},
          "confidence": {"enum": ["low", "medium", "high"]},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "next_moves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "action", "evidence"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "action": {"type": "string", "minLength": 3},
          "evidence": {"type": "string", "minLength": 3}
        }
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_id", "benchmark_version", "benchmark_as_of", "lens_versions", "evaluated_at"],
      "properties": {
        "benchmark_id": {"type": "string"},
        "benchmark_version": {"type": "string"},
        "benchmark_as_of": {"type": "string", "format": "date"},
        "lens_versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "evaluated_at": {"type": "string", "format": "date-time"}
      }
    },
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "uncertainty": {"type": "array", "items": {"type": "string"}}
  }
}
